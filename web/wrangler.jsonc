{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dayle",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/server.mjs",
  "assets": {
    "directory": "dist/browser",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
}
